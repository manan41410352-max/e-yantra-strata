<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">
  <xacro:macro name="realsense2_camera"
    params="name parent tf_prefix:='' width:=640 height:=480 update_rate:=10 *origin">

    <link name="${tf_prefix}${name}_link">
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <box size="0.001 0.001 0.001" />
        </geometry>
      </collision>
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 ${pi/2}" />
        <geometry>
          <mesh filename="file://$(find ur_description)/meshes/realsense/d435i.glb" />
        </geometry>
      </visual>
      <inertial>
        <mass value="1e-5" />
        <origin xyz="0 0 0" rpy="0 0 0" />
        <inertia ixx="1e-9" ixy="0.0" ixz="0.0" iyy="1e-9" iyz="0.0" izz="1e-9" />
      </inertial>
    </link>

    <joint name="${tf_prefix}${name}_joint" type="fixed">
      <parent link="${tf_prefix}${parent}" />
      <child link="${tf_prefix}${name}_link" />
      <xacro:insert_block name="origin" />
    </joint>

    <link name="${tf_prefix}${name}_color_optical_frame">
      <inertial>
        <mass value="1e-5" />
        <origin xyz="0 0 0" rpy="0 0 0" />
        <inertia ixx="1e-9" ixy="0.0" ixz="0.0" iyy="1e-9" iyz="0.0" izz="1e-9" />
      </inertial>
    </link>

    <joint name="${tf_prefix}${name}_color_optical_joint" type="fixed">
      <parent link="${tf_prefix}${name}_link" />
      <child link="${tf_prefix}${name}_color_optical_frame" />
      <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}" />
    </joint>

    <gazebo reference="${tf_prefix}${name}_link">
      <disableFixedJointLumping>true</disableFixedJointLumping>
      <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>
    <gazebo reference="${tf_prefix}${name}_color_optical_frame">
      <disableFixedJointLumping>true</disableFixedJointLumping>
      <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>

    <gazebo reference="${tf_prefix}${name}_link">
      <sensor name="${name}_camera" type="rgbd_camera">
        <camera name="${name}_camera">
          <optical_frame_id>${tf_prefix}${name}_color_optical_frame</optical_frame_id>
          <horizontal_fov>${2*atan(640/915.3003540039062)}</horizontal_fov>
          <distortion>
            <k1>0.0</k1>
            <k2>0.0</k2>
            <k3>0.0</k3>
            <p1>0.0</p1>
            <p2>0.0</p2>
            <center>0.5 0.5</center>
          </distortion>
          <image>
            <width>${width}</width>
            <height>${height}</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>5</far>
          </clip>
          <depth_camera>
            <clip>
              <near>0.1</near>
              <far>5</far>
            </clip>
          </depth_camera>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.002</stddev>
          </noise>
        </camera>
        <always_on>1</always_on>
        <update_rate>${update_rate}</update_rate>
        <visualize>0</visualize>
        <topic>camera</topic>
      </sensor>
    </gazebo>

  </xacro:macro>
</robot>
