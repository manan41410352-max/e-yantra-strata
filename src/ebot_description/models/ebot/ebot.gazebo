<?xml version="1.0"?>
<!--
  eBot Gazebo configuration: the differential drive and odometry plugins, and the
  LiDAR, ultrasonic and contact sensors.

  Copyright (c) e-Yantra, IIT Bombay.
-->
<robot name="ebot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>FWLJ</left_joint>
      <left_joint>RWLJ</left_joint>
      <right_joint>FWRJ</right_joint>
      <right_joint>RWRJ</right_joint>

      <wheel_separation>0.4312</wheel_separation>
      <wheel_radius>0.1</wheel_radius>

      <min_linear_velocity>-0.5</min_linear_velocity>
      <max_linear_velocity>0.5</max_linear_velocity>
      <min_angular_velocity>-1.0</min_angular_velocity>
      <max_angular_velocity>1.0</max_angular_velocity>
      <max_acceleration>10.0</max_acceleration>
      <topic>cmd_vel</topic>
      <frame_id>odom</frame_id>
      <child_frame_id>ebot_base_link</child_frame_id>

    </plugin>
  </gazebo>


  <gazebo>
    <plugin
      filename="gz-sim-odometry-publisher-system"
      name="gz::sim::systems::OdometryPublisher">
      <odom_topic>odom</odom_topic>
      <odom_frame>odom</odom_frame>
      <tf_topic>tf</tf_topic>
      <robot_base_frame>base_footprint</robot_base_frame>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin
      filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">
      <topic>ebot/joint_states</topic>
    </plugin>
  </gazebo>


  <gazebo reference="ebot_base">
    <sensor name='collision_sensor' type='contact'>
      <always_on>true</always_on>
      <update_rate>5</update_rate>
      <contact>
        <collision>base_footprint_fixed_joint_lump__ebot_base_collision</collision>
        <collision>base_footprint_fixed_joint_lump__ebot_base_collision_1</collision>
        <topic>/ebot_contact</topic>
      </contact>
    </sensor>
  </gazebo>


  <gazebo reference="FWL">
    <collision>
    <surface>
      <friction>
        <ode>
          <mu>1.5</mu>   
          <mu2>1.5</mu2>
        </ode>
      </friction>
    </surface>
  </collision>
  </gazebo>

  <gazebo reference="FWR">
    <collision>
    <surface>
      <friction>
        <ode>
          <mu>1.5</mu>   
          <mu2>1.5</mu2>
        </ode>
      </friction>
    </surface>
  </collision>
  </gazebo>

  <gazebo reference="RWL">
    <collision>
    <surface>
      <friction>
        <ode>
          <mu>1.5</mu>   
          <mu2>1.5</mu2>
        </ode>
      </friction>
    </surface>
  </collision>
  </gazebo>

  <gazebo reference="RWR">
    <collision>
    <surface>
      <friction>
        <ode>
          <mu>1.5</mu>   
          <mu2>1.5</mu2>
        </ode>
      </friction>
    </surface>
  </collision>
  </gazebo>



  <gazebo reference="laser">
    <sensor name="laser" type="gpu_lidar">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <visualize>false</visualize>
      <topic>scan</topic>
      <pose>0 0 0 0 0 0</pose>

      <gz_frame_id>laser</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1.0</resolution>
            <min_angle>-1.57</min_angle>
            <max_angle>1.57</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <resolution>0.01</resolution>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.2</min>
          <max>8.0</max>
          <resolution>0.02</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <xacro:macro name="ultrasonic_sensor" params="name">
    <gazebo reference="${name}">
      <sensor name="${name}" type="gpu_lidar">
        <gz_frame_id>${name}</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>5</update_rate>
        <visualize>0</visualize>
        <topic>${name}</topic>
        <pose>0 0 0 0 0 0</pose>
        <lidar>
          <scan>
            <horizontal>
              <samples>5</samples>
              <resolution>1</resolution>
              <min_angle>-0.1309</min_angle>
              <max_angle>0.1309</max_angle>
            </horizontal>
            <vertical>
              <samples>5</samples>
              <resolution>1</resolution>
              <min_angle>-0.01</min_angle>
              <max_angle>0.01</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.03</min>
            <max>4.1</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
      </sensor>
    </gazebo>
  </xacro:macro>

  <xacro:ultrasonic_sensor name="ultrasonic_rl" />
  <xacro:ultrasonic_sensor name="ultrasonic_rr" />

</robot>